# Install with the same peer-dependency rules everywhere (this PC, Heroku, anyone who clones).
# The project has always been installed with legacy-peer-deps (from the user-level ~/.npmrc),
# so package-lock.json is built that way. Without this file Heroku applies strict peer rules,
# demands @langchain/community's optional peer packages, and rejects the lock file.
legacy-peer-deps=true

# onnxruntime-node (pulled in by @chroma-core/default-embed and llamaindex, used only by the
# old chatbot experiments) tries to download a GPU (CUDA) build while installing. That
# download now returns 404 and fails the whole install (GitHub CI, Render). The normal
# CPU build is all this project needs, so the GPU download is skipped.
onnxruntime-node-install-cuda=skip
