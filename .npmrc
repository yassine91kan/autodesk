# Install with the same peer-dependency rules everywhere (this PC, Heroku, anyone who clones).
# The project has always been installed with legacy-peer-deps (from the user-level ~/.npmrc),
# so package-lock.json is built that way. Without this file Heroku applies strict peer rules,
# demands @langchain/community's optional peer packages, and rejects the lock file.
legacy-peer-deps=true
